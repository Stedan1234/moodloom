# Moodloom backend settings. Copy to .env and fill in.
# Only DATABASE_URL and JWT_SECRET are required to run locally.

# ── Required ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/moodloom

# Generate a real one. The backend refuses to start with this placeholder.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Where things live ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# The web app's address: used in password-reset, share and invitation links.
APP_URL=http://localhost:5173
# The address uploaded files are served from. Defaults to http://localhost:<PORT>.
# In production both must be https:// and are normally the same address.
# PUBLIC_BASE_URL=http://localhost:3001
# Web origins allowed to call the API (comma separated). The browser
# extension is always allowed. Not needed when the API serves the web app.
ALLOWED_ORIGINS=http://localhost:5173
# Folder for uploaded files. In production point this at a persistent disk.
# UPLOADS_DIR=/data/uploads
# Serve a built web app from the API (set automatically in production when
# ../frontend/dist exists).
# FRONTEND_DIST=../frontend/dist
# Set to true if your database host requires TLS (most hosted ones do).
# DATABASE_SSL=false
# Only behind a reverse proxy you control, e.g. "1" for one hop. Without it
# rate limits see the proxy's address; with it set wrongly, clients can
# spoof theirs.
# TRUST_PROXY=1

# ── Accounts ─────────────────────────────────────────────────────────────
# How long a login lasts.
# TOKEN_TTL=90d
# Free-plan limits are off until you turn this on.
# ENFORCE_PLAN_LIMITS=false

# ── Email (password resets) ──────────────────────────────────────────────
# With SMTP_HOST blank the reset link is printed in this console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Moodloom <no-reply@yourdomain.com>

# ── AI ───────────────────────────────────────────────────────────────────
# Direction notes need a key from console.anthropic.com. Without one, that
# button explains itself and everything else works.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# anthropic | none | mock (mock writes a canned note; development only)
# AI_LLM_PROVIDER=
# How many references at most are sent for one direction note.
# AI_MAX_IMAGES=10
# "More like this" and grouping: classic (built in, nothing to download),
# clip (downloads a ~350 MB open model on first use, adds search by
# description; needs `npm install @huggingface/transformers`), or off.
# AI_EMBEDDER=classic

# ── Upload size limits, in MB ────────────────────────────────────────────
# MAX_IMAGE_MB=15
# MAX_DOCUMENT_MB=30
# MAX_VIDEO_MB=60
# MAX_FILE_MB=60
