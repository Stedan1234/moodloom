DATABASE_URL=postgresql://user:password@localhost:5432/moodloom

# Generate a real one — do NOT leave this placeholder in place, the backend
# will refuse to start if you do. Run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# and paste the output here.
JWT_SECRET=replace-with-a-long-random-string

PORT=3001
NODE_ENV=development

# Comma-separated list of web-app origins allowed to call this API (the
# browser extension is always allowed separately — see src/config/cors.js).
# Local dev default matches the Vite dev server; add your deployed frontend
# URL here too once you have one.
ALLOWED_ORIGINS=http://localhost:5173

# Leave unset for local dev. Set this only once deployed behind a real
# reverse proxy/load balancer (e.g. "1" for one trusted hop), so rate
# limiting keys off the real client IP instead of the proxy's. See
# src/server.js for why this is dangerous to enable on plain localhost.
# TRUST_PROXY=1

# The public origin uploaded images are served back out from (stored directly
# in board_items.source_url). Defaults to http://localhost:<PORT>, which is
# correct for local dev. Set this to your real deployed origin (e.g.
# https://api.yourapp.com) once deployed — otherwise uploaded images would
# be saved with a localhost URL nobody else can reach.
# PUBLIC_BASE_URL=http://localhost:3001
